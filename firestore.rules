rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Identity & validation primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'mdrashidulislamid20@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isActiveUser() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLanguage(lang) {
      return lang is string && lang in ['en', 'bn', 'bilingual'];
    }

    function isValidFormat(fmt) {
      return fmt is string && fmt in ['wav', 'mp3'];
    }

    function isValidSpeed(spd) {
      return (spd is int || spd is float) && spd >= 0.5 && spd <= 2.0;
    }

    function isValidPitch(pitch) {
      return (pitch is int || pitch is float) && pitch >= -6 && pitch <= 6;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      let allowed = [
        'uid', 'email', 'displayName', 'photoURL', 'role', 'status',
        'defaultLanguage', 'defaultSpeed', 'defaultPitch',
        'defaultFormat', 'themePreference', 'createdAt', 'updatedAt'
      ];
      let required = [
        'uid', 'email', 'displayName', 'role', 'status',
        'defaultLanguage', 'defaultSpeed', 'defaultPitch',
        'defaultFormat', 'themePreference', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(allowed)
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.role is string && data.role in ['user', 'admin']
        && data.status is string && data.status in ['active', 'suspended']
        && isValidLanguage(data.defaultLanguage)
        && isValidSpeed(data.defaultSpeed)
        && isValidPitch(data.defaultPitch)
        && isValidFormat(data.defaultFormat)
        && data.themePreference is string && data.themePreference in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserSettings
    function isValidUserSettings(data) {
      let allowed = [
        'uid', 'defaultVoiceId', 'defaultLanguage', 'defaultSpeed',
        'defaultPitch', 'defaultFormat', 'autoPlayAfterGenerate',
        'playbackSpeed', 'themePreference', 'updatedAt'
      ];
      let required = [
        'uid', 'defaultLanguage', 'defaultSpeed', 'defaultPitch',
        'defaultFormat', 'autoPlayAfterGenerate', 'playbackSpeed',
        'themePreference', 'updatedAt'
      ];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(allowed)
        && isValidId(data.uid)
        && (!('defaultVoiceId' in data) || isValidId(data.defaultVoiceId))
        && isValidLanguage(data.defaultLanguage)
        && isValidSpeed(data.defaultSpeed)
        && isValidPitch(data.defaultPitch)
        && isValidFormat(data.defaultFormat)
        && data.autoPlayAfterGenerate is bool
        && isValidSpeed(data.playbackSpeed)
        && data.themePreference is string && data.themePreference in ['light', 'dark']
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AccountInfo
    function isValidAccountInfo(data) {
      let allowed = [
        'uid', 'displayName', 'email', 'photoURL', 'emailVerified',
        'providerId', 'accountCreatedAt', 'lastSignInAt', 'updatedAt'
      ];
      let required = [
        'uid', 'displayName', 'email', 'emailVerified',
        'providerId', 'accountCreatedAt', 'lastSignInAt', 'updatedAt'
      ];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(allowed)
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.emailVerified is bool
        && data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 64
        && data.accountCreatedAt is string && data.accountCreatedAt.size() >= 1 && data.accountCreatedAt.size() <= 64
        && data.lastSignInAt is string && data.lastSignInAt.size() >= 1 && data.lastSignInAt.size() <= 64
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: VoiceSample
    function isValidVoiceSample(data) {
      let allowed = [
        'id', 'userId', 'voiceId', 'sampleAudioId', 'storagePath',
        'sourceType', 'mimeType', 'durationSec', 'createdAt'
      ];
      return data.keys().hasAll(allowed)
        && data.keys().hasOnly(allowed)
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.voiceId)
        && isValidId(data.sampleAudioId)
        && data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 256
        && data.sourceType is string && data.sourceType in ['microphone', 'upload']
        && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 64
        && (data.durationSec is int || data.durationSec is float) && data.durationSec > 0 && data.durationSec <= 600
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: AdminEntry
    function isValidAdminEntry(data) {
      let required = ['uid', 'email', 'grantedBy', 'createdAt'];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(required)
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: AdminSetup
    function isValidAdminSetup(data) {
      let required = ['claimed', 'claimedAt'];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(required)
        && data.claimed is bool && data.claimed == true
        && data.claimedAt is timestamp;
    }

    // Validation Blueprint: StudioConfig
    function isValidStudioConfig(data) {
      let allowed = [
        'ttsEnabled', 'voiceCloningEnabled', 'maxTextLength',
        'defaultLanguage', 'defaultFormat', 'announcement',
        'updatedBy', 'updatedAt'
      ];
      let required = [
        'ttsEnabled', 'voiceCloningEnabled', 'maxTextLength',
        'defaultLanguage', 'defaultFormat', 'updatedBy', 'updatedAt'
      ];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(allowed)
        && data.ttsEnabled is bool
        && data.voiceCloningEnabled is bool
        && data.maxTextLength is int && data.maxTextLength >= 200 && data.maxTextLength <= 5000
        && isValidLanguage(data.defaultLanguage)
        && isValidFormat(data.defaultFormat)
        && (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 300))
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: VoiceProfile
    function isValidVoiceProfile(data) {
      let allowed = [
        'id', 'userId', 'name', 'status', 'language', 'sourceType',
        'sampleAudioId', 'sampleMimeType', 'sampleDurationSec', 'sampleTranscript',
        'baseVoiceName', 'voiceStylePrompt', 'acousticSummary',
        'pitchRegister', 'speakingTempo', 'timbreProfile',
        'defaultSpeed', 'defaultPitch', 'ownershipVerified',
        'consentStatement', 'verifiedAt', 'previewAudioId',
        'createdAt', 'updatedAt'
      ];
      let required = [
        'id', 'userId', 'name', 'language', 'sourceType',
        'sampleAudioId', 'sampleMimeType', 'sampleDurationSec', 'sampleTranscript',
        'baseVoiceName', 'voiceStylePrompt', 'acousticSummary',
        'pitchRegister', 'speakingTempo', 'timbreProfile',
        'defaultSpeed', 'defaultPitch', 'ownershipVerified',
        'consentStatement', 'verifiedAt', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(allowed)
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && (!('status' in data) || (data.status is string && data.status in ['not_created', 'sample_added', 'processing', 'ready', 'failed']))
        && isValidLanguage(data.language)
        && data.sourceType is string && data.sourceType in ['microphone', 'upload']
        && isValidId(data.sampleAudioId)
        && data.sampleMimeType is string && data.sampleMimeType.size() >= 3 && data.sampleMimeType.size() <= 64
        && (data.sampleDurationSec is int || data.sampleDurationSec is float) && data.sampleDurationSec > 0 && data.sampleDurationSec <= 600
        && data.sampleTranscript is string && data.sampleTranscript.size() <= 2000
        && data.baseVoiceName is string && data.baseVoiceName in ['Puck', 'Charon', 'Kore', 'Fenrir', 'Zephyr']
        && data.voiceStylePrompt is string && data.voiceStylePrompt.size() >= 10 && data.voiceStylePrompt.size() <= 1500
        && data.acousticSummary is string && data.acousticSummary.size() <= 600
        && data.pitchRegister is string && data.pitchRegister.size() >= 1 && data.pitchRegister.size() <= 80
        && data.speakingTempo is string && data.speakingTempo.size() >= 1 && data.speakingTempo.size() <= 80
        && data.timbreProfile is string && data.timbreProfile.size() >= 1 && data.timbreProfile.size() <= 120
        && isValidSpeed(data.defaultSpeed)
        && isValidPitch(data.defaultPitch)
        && data.ownershipVerified == true
        && data.consentStatement is string && data.consentStatement.size() >= 10 && data.consentStatement.size() <= 300
        && data.verifiedAt is timestamp
        && (!('previewAudioId' in data) || isValidId(data.previewAudioId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: GeneratedAudio
    function isValidGeneratedAudio(data) {
      let allowed = [
        'id', 'userId', 'voiceId', 'voiceName', 'title', 'text', 'language',
        'speed', 'pitch', 'styleOverride', 'serverAudioId',
        'durationSec', 'format', 'fileSizeBytes', 'downloadCount',
        'createdAt', 'updatedAt'
      ];
      let required = [
        'id', 'userId', 'voiceId', 'voiceName', 'text', 'language',
        'speed', 'pitch', 'serverAudioId',
        'durationSec', 'format', 'fileSizeBytes', 'downloadCount',
        'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(allowed)
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.voiceId)
        && data.voiceName is string && data.voiceName.size() >= 1 && data.voiceName.size() <= 80
        && (!('title' in data) || (data.title is string && data.title.size() >= 1 && data.title.size() <= 120))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 5000
        && isValidLanguage(data.language)
        && isValidSpeed(data.speed)
        && isValidPitch(data.pitch)
        && (!('styleOverride' in data) || (data.styleOverride is string && data.styleOverride.size() <= 300))
        && isValidId(data.serverAudioId)
        && (data.durationSec is int || data.durationSec is float) && data.durationSec >= 0 && data.durationSec <= 1800
        && isValidFormat(data.format)
        && (data.fileSizeBytes is int || data.fileSizeBytes is float) && data.fileSizeBytes > 0 && data.fileSizeBytes <= 52428800
        && data.downloadCount is int && data.downloadCount >= 0 && data.downloadCount <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: DownloadedAudio
    function isValidDownloadedAudio(data) {
      let allowed = [
        'id', 'userId', 'generatedAudioId', 'serverAudioId',
        'voiceName', 'textSnippet', 'language', 'format',
        'fileSizeBytes', 'downloadedAt'
      ];
      return data.keys().hasAll(allowed)
        && data.keys().hasOnly(allowed)
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.generatedAudioId)
        && isValidId(data.serverAudioId)
        && data.voiceName is string && data.voiceName.size() >= 1 && data.voiceName.size() <= 80
        && data.textSnippet is string && data.textSnippet.size() >= 1 && data.textSnippet.size() <= 200
        && isValidLanguage(data.language)
        && isValidFormat(data.format)
        && (data.fileSizeBytes is int || data.fileSizeBytes is float) && data.fileSizeBytes > 0 && data.fileSizeBytes <= 52428800
        && data.downloadedAt is timestamp;
    }

    // Collection: users
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().email == request.auth.token.email
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().role == 'user'
          || (
            incoming().role == 'admin'
            && (
              isBootstrappedAdmin()
              || (
                !exists(/databases/$(database)/documents/systemConfig/adminSetup)
                && existsAfter(/databases/$(database)/documents/systemConfig/adminSetup)
                && existsAfter(/databases/$(database)/documents/admins/$(userId))
              )
            )
          )
        );
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'defaultLanguage',
              'defaultSpeed', 'defaultPitch', 'defaultFormat',
              'themePreference', 'updatedAt'
            ])
          )
          || (
            isAdmin()
            && userId != request.auth.uid
            && existing().email != 'mdrashidulislamid20@gmail.com'
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // Collection: settings
    match /settings/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isActiveUser()
        && isValidUserSettings(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isActiveUser()
        && isValidUserSettings(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'defaultVoiceId', 'defaultLanguage', 'defaultSpeed',
          'defaultPitch', 'defaultFormat', 'autoPlayAfterGenerate',
          'playbackSpeed', 'themePreference', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection: accountInfo
    match /accountInfo/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidAccountInfo(incoming())
        && incoming().uid == userId
        && incoming().email == request.auth.token.email
        && incoming().emailVerified == request.auth.token.email_verified
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidAccountInfo(incoming())
        && incoming().uid == existing().uid
        && incoming().email == request.auth.token.email
        && incoming().emailVerified == request.auth.token.email_verified
        && incoming().accountCreatedAt == existing().accountCreatedAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'emailVerified',
          'providerId', 'lastSignInAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection: voiceSamples
    match /voiceSamples/{sampleId} {
      allow get: if isValidId(sampleId) && (isOwner(existing().userId) || isAdmin());
      allow list: if (isVerifiedUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isValidId(sampleId)
        && isVerifiedUser()
        && isActiveUser()
        && isValidVoiceSample(incoming())
        && incoming().id == sampleId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/voiceProfiles/$(incoming().voiceId))
        && get(/databases/$(database)/documents/voiceProfiles/$(incoming().voiceId)).data.userId == incoming().userId;
      allow update: if false;
      allow delete: if isValidId(sampleId) && (isOwner(existing().userId) || isAdmin());
    }

    // Collection: admins
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminUid)
        && isVerifiedUser()
        && isValidAdminEntry(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (adminUid == request.auth.uid && isBootstrappedAdmin())
          || (
            adminUid == request.auth.uid
            && !exists(/databases/$(database)/documents/systemConfig/adminSetup)
            && existsAfter(/databases/$(database)/documents/systemConfig/adminSetup)
          )
        );
      allow update: if false;
      allow delete: if isValidId(adminUid)
        && isAdmin()
        && adminUid != request.auth.uid
        && existing().email != 'mdrashidulislamid20@gmail.com';
    }

    // Collection: systemConfig (adminSetup & studio settings)
    match /systemConfig/{configId} {
      allow get: if isValidId(configId) && isVerifiedUser() && configId in ['adminSetup', 'studio'];
      allow list: if false;
      allow create: if isValidId(configId)
        && isVerifiedUser()
        && (
          (
            configId == 'adminSetup'
            && !exists(/databases/$(database)/documents/systemConfig/adminSetup)
            && isValidAdminSetup(incoming())
            && incoming().claimed == true
            && incoming().claimedAt == request.time
            && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid))
          )
          || (
            configId == 'studio'
            && isAdmin()
            && isValidStudioConfig(incoming())
            && incoming().updatedAt == request.time
          )
        );
      allow update: if isValidId(configId)
        && configId == 'studio'
        && isAdmin()
        && isValidStudioConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Collection: voiceProfiles
    match /voiceProfiles/{voiceId} {
      allow get: if isValidId(voiceId) && (isOwner(existing().userId) || isAdmin());
      allow list: if (isVerifiedUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isValidId(voiceId)
        && isVerifiedUser()
        && isActiveUser()
        && isValidVoiceProfile(incoming())
        && incoming().id == voiceId
        && incoming().userId == request.auth.uid
        && incoming().verifiedAt == request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(voiceId)
        && isVerifiedUser()
        && isActiveUser()
        && (isOwner(existing().userId) || isAdmin())
        && isValidVoiceProfile(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().sourceType == existing().sourceType
        && incoming().sampleAudioId == existing().sampleAudioId
        && incoming().ownershipVerified == existing().ownershipVerified
        && incoming().consentStatement == existing().consentStatement
        && incoming().verifiedAt == existing().verifiedAt
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'status', 'language', 'defaultSpeed', 'defaultPitch', 'voiceStylePrompt', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['previewAudioId', 'updatedAt'])
        );
      allow delete: if isValidId(voiceId) && (isOwner(existing().userId) || isAdmin());
    }

    // Collection: generatedAudios
    match /generatedAudios/{audioId} {
      allow get: if isValidId(audioId) && (isOwner(existing().userId) || isAdmin());
      allow list: if (isVerifiedUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isValidId(audioId)
        && isVerifiedUser()
        && isActiveUser()
        && isValidGeneratedAudio(incoming())
        && incoming().id == audioId
        && incoming().userId == request.auth.uid
        && incoming().downloadCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/voiceProfiles/$(incoming().voiceId))
        && get(/databases/$(database)/documents/voiceProfiles/$(incoming().voiceId)).data.userId == incoming().userId;
      allow update: if isValidId(audioId)
        && isVerifiedUser()
        && isOwner(existing().userId)
        && isValidGeneratedAudio(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().voiceId == existing().voiceId
        && incoming().serverAudioId == existing().serverAudioId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().downloadCount == existing().downloadCount + 1
        && incoming().diff(existing()).affectedKeys().hasOnly(['downloadCount', 'updatedAt']);
      allow delete: if isValidId(audioId) && (isOwner(existing().userId) || isAdmin());
    }

    // Collection: downloadedAudios
    match /downloadedAudios/{downloadId} {
      allow get: if isValidId(downloadId) && (isOwner(existing().userId) || isAdmin());
      allow list: if (isVerifiedUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isValidId(downloadId)
        && isVerifiedUser()
        && isActiveUser()
        && isValidDownloadedAudio(incoming())
        && incoming().id == downloadId
        && incoming().userId == request.auth.uid
        && incoming().downloadedAt == request.time
        && exists(/databases/$(database)/documents/generatedAudios/$(incoming().generatedAudioId))
        && get(/databases/$(database)/documents/generatedAudios/$(incoming().generatedAudioId)).data.userId == incoming().userId;
      allow update: if false;
      allow delete: if isValidId(downloadId) && (isOwner(existing().userId) || isAdmin());
    }
  }
}
