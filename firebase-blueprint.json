{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account, role, moderation status, and default studio voice settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "defaultLanguage": {
          "type": "string",
          "enum": ["en", "bn", "bilingual"]
        },
        "defaultSpeed": {
          "type": "number"
        },
        "defaultPitch": {
          "type": "number"
        },
        "defaultFormat": {
          "type": "string",
          "enum": ["wav", "mp3"]
        },
        "themePreference": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "status",
        "defaultLanguage",
        "defaultSpeed",
        "defaultPitch",
        "defaultFormat",
        "themePreference",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Per-user VoiceCraft Settings covering default voice, language, generation, and audio playback preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "defaultVoiceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "defaultLanguage": {
          "type": "string",
          "enum": ["en", "bn", "bilingual"]
        },
        "defaultSpeed": {
          "type": "number"
        },
        "defaultPitch": {
          "type": "number"
        },
        "defaultFormat": {
          "type": "string",
          "enum": ["wav", "mp3"]
        },
        "autoPlayAfterGenerate": {
          "type": "boolean"
        },
        "playbackSpeed": {
          "type": "number"
        },
        "themePreference": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "defaultLanguage",
        "defaultSpeed",
        "defaultPitch",
        "defaultFormat",
        "autoPlayAfterGenerate",
        "playbackSpeed",
        "themePreference",
        "updatedAt"
      ]
    },
    "AccountInfo": {
      "title": "AccountInfo",
      "description": "Firebase Authentication metadata synced for the signed-in user's Account Information panel.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512
        },
        "emailVerified": {
          "type": "boolean"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accountCreatedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lastSignInAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "emailVerified",
        "providerId",
        "accountCreatedAt",
        "lastSignInAt",
        "updatedAt"
      ]
    },
    "VoiceSample": {
      "title": "VoiceSample",
      "description": "Secure reference record linking a user's uploaded or recorded audio sample to their cloned voice profile.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "voiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sampleAudioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storagePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceType": {
          "type": "string",
          "enum": ["microphone", "upload"]
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "durationSec": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "voiceId",
        "sampleAudioId",
        "storagePath",
        "sourceType",
        "mimeType",
        "durationSec",
        "createdAt"
      ]
    },
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Trusted admin role assignment record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "AdminSetup": {
      "title": "AdminSetup",
      "description": "Write-once singleton lock recording that first-user admin bootstrap completed.",
      "type": "object",
      "properties": {
        "claimed": {
          "type": "boolean"
        },
        "claimedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["claimed", "claimedAt"]
    },
    "StudioConfig": {
      "title": "StudioConfig",
      "description": "Admin-managed platform controls for voice generation and voice cloning.",
      "type": "object",
      "properties": {
        "ttsEnabled": {
          "type": "boolean"
        },
        "voiceCloningEnabled": {
          "type": "boolean"
        },
        "maxTextLength": {
          "type": "number"
        },
        "defaultLanguage": {
          "type": "string",
          "enum": ["en", "bn", "bilingual"]
        },
        "defaultFormat": {
          "type": "string",
          "enum": ["wav", "mp3"]
        },
        "announcement": {
          "type": "string",
          "maxLength": 300
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ttsEnabled",
        "voiceCloningEnabled",
        "maxTextLength",
        "defaultLanguage",
        "defaultFormat",
        "updatedBy",
        "updatedAt"
      ]
    },
    "VoiceProfile": {
      "title": "VoiceProfile",
      "description": "Personal AI cloned voice profile with ownership verification, processing status, and acoustic DNA.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["not_created", "sample_added", "processing", "ready", "failed"]
        },
        "language": {
          "type": "string",
          "enum": ["en", "bn", "bilingual"]
        },
        "sourceType": {
          "type": "string",
          "enum": ["microphone", "upload"]
        },
        "sampleAudioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sampleMimeType": {
          "type": "string",
          "maxLength": 64
        },
        "sampleDurationSec": {
          "type": "number"
        },
        "sampleTranscript": {
          "type": "string",
          "maxLength": 2000
        },
        "baseVoiceName": {
          "type": "string",
          "enum": ["Puck", "Charon", "Kore", "Fenrir", "Zephyr"]
        },
        "voiceStylePrompt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500
        },
        "acousticSummary": {
          "type": "string",
          "maxLength": 600
        },
        "pitchRegister": {
          "type": "string",
          "maxLength": 80
        },
        "speakingTempo": {
          "type": "string",
          "maxLength": 80
        },
        "timbreProfile": {
          "type": "string",
          "maxLength": 120
        },
        "defaultSpeed": {
          "type": "number"
        },
        "defaultPitch": {
          "type": "number"
        },
        "ownershipVerified": {
          "type": "boolean"
        },
        "consentStatement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "previewAudioId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "language",
        "sourceType",
        "sampleAudioId",
        "sampleMimeType",
        "sampleDurationSec",
        "sampleTranscript",
        "baseVoiceName",
        "voiceStylePrompt",
        "acousticSummary",
        "pitchRegister",
        "speakingTempo",
        "timbreProfile",
        "defaultSpeed",
        "defaultPitch",
        "ownershipVerified",
        "consentStatement",
        "verifiedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "GeneratedAudio": {
      "title": "GeneratedAudio",
      "description": "Text-to-speech synthesis entry generated with a user's cloned voice.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "voiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "voiceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "language": {
          "type": "string",
          "enum": ["en", "bn", "bilingual"]
        },
        "speed": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        },
        "styleOverride": {
          "type": "string",
          "maxLength": 300
        },
        "serverAudioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "durationSec": {
          "type": "number"
        },
        "format": {
          "type": "string",
          "enum": ["wav", "mp3"]
        },
        "fileSizeBytes": {
          "type": "number"
        },
        "downloadCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "voiceId",
        "voiceName",
        "text",
        "language",
        "speed",
        "pitch",
        "serverAudioId",
        "durationSec",
        "format",
        "fileSizeBytes",
        "downloadCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "DownloadedAudio": {
      "title": "DownloadedAudio",
      "description": "Export and download ledger for user-generated audio files.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "generatedAudioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serverAudioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "voiceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "textSnippet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "language": {
          "type": "string",
          "enum": ["en", "bn", "bilingual"]
        },
        "format": {
          "type": "string",
          "enum": ["wav", "mp3"]
        },
        "fileSizeBytes": {
          "type": "number"
        },
        "downloadedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "generatedAudioId",
        "serverAudioId",
        "voiceName",
        "textSnippet",
        "language",
        "format",
        "fileSizeBytes",
        "downloadedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile, RBAC role, account status, and default studio preferences."
    },
    "/settings/{userId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User-scoped VoiceCraft Settings (default voice, language, generation, and audio playback settings)."
    },
    "/accountInfo/{userId}": {
      "schema": { "$ref": "#/entities/AccountInfo" },
      "description": "User-scoped Google Account metadata synchronized from Firebase Authentication."
    },
    "/voiceSamples/{sampleId}": {
      "schema": { "$ref": "#/entities/VoiceSample" },
      "description": "User-scoped secure references for voice sample audio files linked to cloned voice profiles."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Trusted admin role assignment documents."
    },
    "/systemConfig/adminSetup": {
      "schema": { "$ref": "#/entities/AdminSetup" },
      "description": "Write-once singleton lock for first-user admin claiming."
    },
    "/systemConfig/studio": {
      "schema": { "$ref": "#/entities/StudioConfig" },
      "description": "Admin-managed VoiceCraft platform settings and feature toggles."
    },
    "/voiceProfiles/{voiceId}": {
      "schema": { "$ref": "#/entities/VoiceProfile" },
      "description": "Owner-scoped cloned AI voice profiles with verified voice ownership and processing status."
    },
    "/generatedAudios/{audioId}": {
      "schema": { "$ref": "#/entities/GeneratedAudio" },
      "description": "Owner-scoped history of synthesized speech clips."
    },
    "/downloadedAudios/{downloadId}": {
      "schema": { "$ref": "#/entities/DownloadedAudio" },
      "description": "Owner-scoped history of exported MP3 and WAV downloads."
    }
  }
}
